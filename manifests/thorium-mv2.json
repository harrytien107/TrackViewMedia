{
  "manifest_version": 2,
  "name": "TrackViewMedia (Thorium)",
  "version": "0.2.7",
  "description": "Show verified publication dates and available views on public Reels, videos, and YouTube Shorts; export selected items.",
  "key": "",
  "update_url": "https://raw.githubusercontent.com/harrytien107/TrackViewMedia/main/thorium-updates.xml",
  "permissions": [
    "storage",
    "downloads",
    "https://*.instagram.com/*",
    "https://*.tiktok.com/*",
    "https://*.facebook.com/*",
    "https://*.youtube.com/*"
  ],
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "TrackViewMedia"
  },
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.instagram.com/*",
        "https://*.tiktok.com/*",
        "https://*.facebook.com/*",
        "https://*.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
