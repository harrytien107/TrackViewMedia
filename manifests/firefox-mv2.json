{
  "manifest_version": 2,
  "name": "TrackViewMedia (Firefox Test)",
  "version": "0.1.9",
  "description": "Show verified publication dates and available views on public Reels and videos; export selected items.",
  "permissions": [
    "storage",
    "downloads",
    "https://*.instagram.com/*",
    "https://*.tiktok.com/*",
    "https://*.facebook.com/*"
  ],
  "browser_action": { "default_popup": "popup.html", "default_title": "TrackViewMedia" },
  "background": { "scripts": ["background.js"], "persistent": false },
  "content_scripts": [
    {
      "matches": [
        "https://*.instagram.com/*",
        "https://*.tiktok.com/*",
        "https://*.facebook.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": { "gecko": { "id": "track-view-media-test@local" } }
}
